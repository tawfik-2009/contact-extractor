{
  "expo": {
    "name": "بنيان بلس",
    "slug": "bonyan-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0e4d8d"
    },
    "android": {
      "package": "com.bonyanplus.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0e4d8d"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bonyanplus.app"
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
